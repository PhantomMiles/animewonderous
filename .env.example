# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project -> Settings -> Environment Variables.

# --- Paystack ---
# Server-only. NEVER prefix with NEXT_PUBLIC_. Use sk_test_... locally, sk_live_... in Production.
PAYSTACK_SECRET_KEY=

# Safe for the browser. Not used by the current redirect flow, but reserved for a popup checkout later.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Database (Prisma Postgres via Vercel) ---
# In your Vercel project: Storage tab -> Create Database -> Postgres.
# This provisions Prisma Postgres and automatically injects DATABASE_URL,
# POSTGRES_URL and PRISMA_DATABASE_URL into your Vercel project's env vars —
# you don't set these by hand there. Prisma ORM reads DATABASE_URL, so once
# the database is connected to this project in the dashboard, deploys work
# with no further action.
#
# For LOCAL development only: run `vercel env pull .env.local` after
# connecting the database (requires the Vercel CLI, `npm i -g vercel`) to
# copy that same DATABASE_URL down to your machine. Don't type it by hand —
# copy/paste from the dashboard or the pulled file.
DATABASE_URL=
