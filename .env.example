# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project -> Settings -> Environment Variables.

# --- Database ---
# Local or Vercel Postgres connection string
DATABASE_URL=

# --- Authentication (NextAuth) ---
# Generate using `openssl rand -base64 32`
AUTH_SECRET=

# --- Paystack (Payments) ---
# Server-only. Use sk_test_... locally, sk_live_... in Production.
PAYSTACK_SECRET_KEY=
# Safe for the browser.
PAYSTACK_PUBLIC_KEY=

# --- Cloudinary (Media Uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- Resend (Transactional Emails) ---
# Optional. If omitted, the app will log emails to the console in development.
RESEND_API_KEY=
