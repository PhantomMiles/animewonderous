generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------
// Auth.js (NextAuth v5) Models
// -----------------------------------------
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  banner        String?
  password      String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]

  // Relations
  communities     CommunityMember[]
  forumPosts      ForumPost[]
  forumComments   ForumComment[]
  forumLikes      ForumLike[]
  commentLikes    CommentLike[]
  pollVotes       PollVote[]

  banned        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  SUPERADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// Existing Models with updates
// -----------------------------------------

model Product {
  id          String      @id
  name        String
  category    String
  price       Int
  currency    String      @default("₦")
  rating      Float       @default(0)
  images      String[]
  description String
  stock       Int         @default(0)
  tags        String[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Event {
  id                String               @id
  title             String
  date              String
  location          String
  category          String
  price             Int
  image             String
  description       String
  featured          Boolean              @default(false)
  hasUniversityHubs Boolean              @default(false)
  universityHubs    EventUniversityHub[]
  ticketTiers       TicketTier[]
  orderItems        OrderItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model EventUniversityHub {
  id       String @id @default(cuid())
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  name     String
  location String
  role     String

  @@index([eventId])
}

model TicketTier {
  id         String      @id
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  title      String
  theme      String
  capacity   String
  groupSize  Int
  price      Int
  perks      String[]
  orderItems OrderItem[]

  @@index([eventId])
}

model Community {
  id          String   @id
  name        String
  avatar      String
  banner      String
  verified    Boolean  @default(false)
  tags        String[]
  description String
  rules       String[]
  
  banned      Boolean  @default(false)
  
  members     CommunityMember[]
  forumPosts  ForumPost[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CommunityRole {
  ADMIN
  MODERATOR
  MEMBER
}

model CommunityMember {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  role        CommunityRole @default(MEMBER)
  
  joinedAt    DateTime @default(now())

  @@unique([userId, communityId])
}

enum PostType {
  TEXT
  POLL
}

model ForumPost {
  id             String   @id @default(cuid())
  type           PostType @default(TEXT)
  title          String
  body           String
  category       String
  image          String?
  
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  
  community      Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId    String?

  comments       ForumComment[]
  likes          ForumLike[]
  pollOptions    PollOption[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PollOption {
  id        String     @id @default(cuid())
  text      String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  votes     PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
}

model ForumComment {
  id          String   @id @default(cuid())
  body        String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String

  // Nested replies (Reddit-style threading)
  parent      ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  replies     ForumComment[] @relation("CommentReplies")

  likes       CommentLike[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommentLike {
  id          String      @id @default(cuid())
  comment     ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime    @default(now())

  @@unique([commentId, userId])
}

model ForumLike {
  id          String   @id @default(cuid())
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  
  @@unique([postId, userId])
}

// -----------------------------------------
// Orders & Tickets
// -----------------------------------------
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum OrderItemKind {
  PRODUCT
  TICKET
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  status        OrderStatus @default(PENDING)
  customerEmail String
  subtotal      Int
  shipping      Int         @default(0)
  total         Int
  currency      String      @default("NGN")
  paidAt           DateTime?
  deliveryStatus   DeliveryStatus @default(PROCESSING)
  items            OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerEmail])
}

model OrderItem {
  id      String        @id @default(cuid())
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  kind    OrderItemKind

  name      String
  unitPrice Int
  quantity  Int

  product      Product?    @relation(fields: [productId], references: [id])
  productId    String?
  event        Event?      @relation(fields: [eventId], references: [id])
  eventId      String?
  ticketTier   TicketTier? @relation(fields: [ticketTierId], references: [id])
  ticketTierId String?

  tickets Ticket[]

  @@index([orderId])
}

enum TicketStatus {
  VALID
  USED
  EXPIRED
}

model Ticket {
  id          String       @id @default(cuid())
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  code        String       @unique
  status      TicketStatus @default(VALID)
  createdAt   DateTime     @default(now())

  @@index([orderItemId])
}
